          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e9" edge="1" parent="1" source="db" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;dashed=1;" target="cdn" value="Playback URL">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="note1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;align=left;" value="&lt;b&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;Request flow&lt;/b&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;1. User -&amp;gt; DNS -&amp;gt; Load Balancer -&amp;gt; App Server&lt;br&gt;2. App checks Redis first; on miss, reads DB and caches the result.&lt;br&gt;3. For playback, App returns a playback URL; CDN delivers video bytes.&lt;br&gt;4. Health checks remove unhealthy app servers from rotation.&lt;/div&gt;" vertex="1">
          <mxGeometry height="180" width="620" x="120" y="500" as="geometry" />
        </mxCell>
        <mxCell id="note2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;align=left;" value="&lt;b&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;Why this design?&lt;/b&gt;&lt;br&gt;Load Balancer = traffic distribution&lt;br&gt;Multiple App Servers = horizontal scaling + fault tolerance&lt;br&gt;Redis = low latency + less DB load&lt;br&gt;Database = durable application data&lt;br&gt;Storage + CDN = scalable video delivery" vertex="1">
          <mxGeometry height="135" width="620" x="120" y="710" as="geometry" />
        </mxCell>
        <mxCell id="o5_fzKmnKfRbeR16Ik1X-1" edge="1" parent="1" source="app" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;dashed=1;" target="db" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="990" y="325" as="sourcePoint" />
            <mxPoint x="1000" y="650" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="db" parent="1" style="shape=cylinder;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;fontStyle=1;" value="Database&lt;br&gt;&lt;br&gt;Users - Profiles - Content - Subscriptions - Watch Progress" vertex="1">
          <mxGeometry height="125" width="300" x="850" y="425" as="geometry" />
        </mxCell>
        <mxCell id="o5_fzKmnKfRbeR16Ik1X-2" parent="1" style="text;whiteSpace=wrap;html=1;" value="&lt;div style=&quot;forced-color-adjust: none; font-family: Helvetica; font-size: 12px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: left; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(27, 29, 30); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; box-shadow: none !important;&quot;&gt;&lt;span style=&quot;forced-color-adjust: none; background-color: transparent; font-size: 7px; color: light-dark(rgb(255, 255, 255), rgb(22, 22, 22)); box-shadow: none !important;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;color: rgb(255, 255, 255); text-align: center; background-color: rgb(27, 29, 30);&quot;&gt;FUNCTIONAL REQUIREMENTS&lt;/span&gt;&lt;br class=&quot;Apple-interchange-newline&quot;&gt;1. Login/Signup.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;forced-color-adjust: none; font-family: Helvetica; font-size: 12px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: left; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(27, 29, 30); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; box-shadow: none !important;&quot;&gt;&lt;font style=&quot;forced-color-adjust: none; font-size: 7px; color: light-dark(rgb(255, 255, 255), rgb(22, 22, 22)); box-shadow: none !important;&quot;&gt;2. Multiple profiles in one acc.&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;forced-color-adjust: none; font-family: Helvetica; font-size: 12px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: left; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(27, 29, 30); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; color: rgb(255, 255, 255); box-shadow: none !important;&quot;&gt;&lt;font style=&quot;forced-color-adjust: none; font-size: 7px; color: light-dark(rgb(255, 255, 255), rgb(22, 22, 22)); box-shadow: none !important;&quot;&gt;3. Manage profiles.&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;forced-color-adjust: none; font-family: Helvetica; font-size: 12px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: left; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(27, 29, 30); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; color: rgb(255, 255, 255); box-shadow: none !important;&quot;&gt;&lt;font style=&quot;forced-color-adjust: none; font-size: 7px; color: light-dark(rgb(255, 255, 255), rgb(22, 22, 22)); box-shadow: none !important;&quot;&gt;4. Browse Movies, TV Shows.&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;forced-color-adjust: none; font-family: Helvetica; font-size: 12px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: left; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(27, 29, 30); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; color: rgb(255, 255, 255); box-shadow: none !important;&quot;&gt;&lt;font style=&quot;forced-color-adjust: none; font-size: 7px; color: light-dark(rgb(255, 255, 255), rgb(22, 22, 22)); box-shadow: none !important;&quot;&gt;5. User can view content details.&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;forced-color-adjust: none; font-family: Helvetica; font-size: 12px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: left; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(27, 29, 30); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; color: rgb(255, 255, 255); box-shadow: none !important;&quot;&gt;&lt;font style=&quot;forced-color-adjust: none; font-size: 7px; color: light-dark(rgb(255, 255, 255), rgb(22, 22, 22)); box-shadow: none !important;&quot;&gt;6. User can search name of series, movie or actor&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;forced-color-adjust: none; font-family: Helvetica; font-size: 12px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: left; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(27, 29, 30); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; color: rgb(255, 255, 255); box-shadow: none !important;&quot;&gt;&lt;font style=&quot;forced-color-adjust: none; font-size: 7px; color: light-dark(rgb(255, 255, 255), rgb(22, 22, 22)); box-shadow: none !important;&quot;&gt;7. System recommend movies/shows on the basis watch history, preferences, ratings.&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;forced-color-adjust: none; font-family: Helvetica; font-size: 12px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: left; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(27, 29, 30); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; color: rgb(255, 255, 255); box-shadow: none !important;&quot;&gt;&lt;font style=&quot;forced-color-adjust: none; font-size: 7px; color: light-dark(rgb(255, 255, 255), rgb(22, 22, 22)); box-shadow: none !important;&quot;&gt;8. User can play, pause, resume, seek forward and backward, adjust quality of streaming.&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;forced-color-adjust: none; font-family: Helvetica; font-size: 12px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: left; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(27, 29, 30); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; color: rgb(255, 255, 255); box-shadow: none !important;&quot;&gt;&lt;font style=&quot;forced-color-adjust: none; font-size: 7px; color: light-dark(rgb(255, 255, 255), rgb(22, 22, 22)); box-shadow: none !important;&quot;&gt;9. Store user&#39;s playback position, User can resume from where left.&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;forced-color-adjust: none; font-family: Helvetica; font-size: 12px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: left; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(27, 29, 30); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; color: rgb(255, 255, 255); box-shadow: none !important;&quot;&gt;&lt;font style=&quot;forced-color-adjust: none; font-size: 7px; color: light-dark(rgb(255, 255, 255), rgb(22, 22, 22)); box-shadow: none !important;&quot;&gt;10. Maintain previous watched content.&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;forced-color-adjust: none; font-family: Helvetica; font-size: 12px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: left; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(27, 29, 30); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; color: rgb(255, 255, 255); box-shadow: none !important;&quot;&gt;&lt;font style=&quot;forced-color-adjust: none; font-size: 7px; color: light-dark(rgb(255, 255, 255), rgb(22, 22, 22)); box-shadow: none !important;&quot;&gt;11. User can subscribe a plan, Different plans for different prices.&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;forced-color-adjust: none; font-family: Helvetica; font-size: 12px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: left; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(27, 29, 30); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; color: rgb(255, 255, 255); box-shadow: none !important;&quot;&gt;&lt;font style=&quot;forced-color-adjust: none; font-size: 7px; color: light-dark(rgb(255, 255, 255), rgb(22, 22, 22)); box-shadow: none !important;&quot;&gt;12. User can manage the subscription.&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="180" width="290" x="50" y="295" as="geometry" />
        </mxCell>
        <mxCell id="o5_fzKmnKfRbeR16Ik1X-3" parent="1" style="text;whiteSpace=wrap;html=1;" value="&lt;div style=&quot;forced-color-adjust: none; font-family: Helvetica; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: left; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; background-color: light-dark(rgb(27, 29, 30), rgb(211, 213, 214)); box-shadow: none !important;&quot;&gt;&lt;span style=&quot;color: light-dark(rgb(255, 255, 255), rgb(22, 22, 22)); font-size: 7px; forced-color-adjust: none; background-color: transparent; box-shadow: none !important;&quot;&gt;&lt;span style=&quot;forced-color-adjust: none; box-shadow: none !important; white-space: pre;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;/span&gt;&lt;/span&gt;&lt;span style=&quot;forced-color-adjust: none; box-shadow: none !important; white-space: pre;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;/span&gt;&lt;/span&gt;&lt;span style=&quot;forced-color-adjust: none; box-shadow: none !important; white-space: pre;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&amp;nbsp;&amp;nbsp;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;NON-&lt;/span&gt;&lt;/span&gt;&lt;span style=&quot;forced-color-adjust: none; color: rgb(255, 255, 255); text-align: center; background-color: rgb(27, 29, 30); box-shadow: none !important;&quot;&gt;FUNCTIONAL REQUIREMENTS&lt;/span&gt;&lt;br class=&quot;Apple-interchange-newline&quot; style=&quot;forced-color-adjust: none; box-shadow: none !important;&quot;&gt;1.&amp;nbsp;&lt;/span&gt;&lt;font style=&quot;font-size: 7px; color: light-dark(rgb(0, 0, 0), rgb(10, 10, 10));&quot;&gt;&lt;strong data-start=&quot;85&quot; data-end=&quot;106&quot; style=&quot;background-color: transparent;&quot;&gt;High Availability&lt;/strong&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt; — System should remain available even if some servers or services fail.&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;forced-color-adjust: none; font-family: Helvetica; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: left; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; background-color: light-dark(rgb(27, 29, 30), rgb(211, 213, 214)); box-shadow: none !important;&quot;&gt;&lt;font style=&quot;color: light-dark(rgb(255, 255, 255), rgb(22, 22, 22)); font-size: 7px; forced-color-adjust: none; box-shadow: none !important;&quot;&gt;2.&amp;nbsp;&lt;/font&gt;&lt;font style=&quot;font-size: 7px; color: light-dark(rgb(0, 0, 0), rgb(8, 8, 8));&quot;&gt;&lt;strong data-start=&quot;183&quot; data-end=&quot;198&quot; style=&quot;background-color: transparent;&quot;&gt;Scalability&lt;/strong&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt; — System should handle a huge number of users and concurrent video streams and scale horizontally as traffic increases.&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;forced-color-adjust: none; font-family: Helvetica; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: left; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; background-color: rgb(27, 29, 30); box-shadow: none !important;&quot;&gt;&lt;font style=&quot;color: light-dark(rgb(255, 255, 255), rgb(22, 22, 22)); font-size: 7px; forced-color-adjust: none; box-shadow: none !important;&quot;&gt;3.&amp;nbsp;&lt;/font&gt;&lt;font style=&quot;font-size: 7px; color: light-dark(rgb(0, 0, 0), rgb(10, 10, 10));&quot;&gt;&lt;strong data-start=&quot;323&quot; data-end=&quot;338&quot; style=&quot;background-color: transparent;&quot;&gt;Low Latency&lt;/strong&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt; — User requests such as browsing, searching, and starting a video should have low response time with minimal buffering.&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;forced-color-adjust: none; font-family: Helvetica; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: left; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; background-color: rgb(27, 29, 30); box-shadow: none !important;&quot;&gt;&lt;font style=&quot;color: light-dark(rgb(255, 255, 255), rgb(22, 22, 22)); font-size: 7px; forced-color-adjust: none; box-shadow: none !important;&quot;&gt;4.&amp;nbsp;&lt;/font&gt;&lt;font style=&quot;font-size: 7px; color: light-dark(rgb(0, 0, 0), rgb(12, 12, 12));&quot;&gt;&lt;strong data-start=&quot;463&quot; data-end=&quot;482&quot; style=&quot;background-color: transparent;&quot;&gt;High Throughput&lt;/strong&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt; — System should handle a very large number of requests, playback events, and concurrent streaming sessions.&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;forced-color-adjust: none; font-family: Helvetica; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: left; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; background-color: rgb(27, 29, 30); box-shadow: none !important;&quot;&gt;&lt;font style=&quot;color: light-dark(rgb(255, 255, 255), rgb(22, 22, 22)); font-size: 7px; forced-color-adjust: none; box-shadow: none !important;&quot;&gt;5.&amp;nbsp;&lt;/font&gt;&lt;font style=&quot;font-size: 7px; color: light-dark(rgb(0, 0, 0), rgb(10, 10, 10));&quot;&gt;&lt;strong data-start=&quot;595&quot; data-end=&quot;614&quot; style=&quot;background-color: transparent;&quot;&gt;Fault Tolerance&lt;/strong&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt; — System should continue operating even when individual components fail, using replication, health checks, retries, and failover.&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;forced-color-adjust: none; font-family: Helvetica; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: left; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; background-color: rgb(27, 29, 30); box-shadow: none !important;&quot;&gt;&lt;font style=&quot;color: light-dark(rgb(255, 255, 255), rgb(22, 22, 22)); font-size: 7px; forced-color-adjust: none; box-shadow: none !important;&quot;&gt;6.&amp;nbsp;&lt;/font&gt;&lt;font style=&quot;font-size: 7px; color: light-dark(rgb(0, 0, 0), rgb(12, 12, 12));&quot;&gt;&lt;strong data-start=&quot;749&quot; data-end=&quot;763&quot; style=&quot;background-color: transparent;&quot;&gt;Durability&lt;/strong&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt; — Important user data such as profiles, watch history, playback position, and subscriptions should not be lost.&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;forced-color-adjust: none; font-family: Helvetica; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: left; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; background-color: rgb(27, 29, 30); box-shadow: none !important;&quot;&gt;&lt;font style=&quot;color: light-dark(rgb(255, 255, 255), rgb(22, 22, 22)); font-size: 7px; forced-color-adjust: none; box-shadow: none !important;&quot;&gt;7.&amp;nbsp;&lt;/font&gt;&lt;font style=&quot;font-size: 7px; color: light-dark(rgb(0, 0, 0), rgb(12, 12, 12));&quot;&gt;&lt;strong data-start=&quot;880&quot; data-end=&quot;903&quot; style=&quot;background-color: transparent;&quot;&gt;Global Availability&lt;/strong&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt; — System should be accessible worldwide and provide low-latency content delivery to users in different regions.&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;forced-color-adjust: none; font-family: Helvetica; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: left; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; background-color: rgb(27, 29, 30); box-shadow: none !important;&quot;&gt;&lt;font style=&quot;color: light-dark(rgb(255, 255, 255), rgb(22, 22, 22)); font-size: 7px; forced-color-adjust: none; box-shadow: none !important;&quot;&gt;8.&amp;nbsp;&lt;/font&gt;&lt;font style=&quot;font-size: 7px; color: light-dark(rgb(0, 0, 0), rgb(10, 10, 10));&quot;&gt;&lt;strong data-start=&quot;1020&quot; data-end=&quot;1032&quot; style=&quot;background-color: transparent;&quot;&gt;Security&lt;/strong&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt; — System should protect user accounts, authentication data, subscription information, APIs, and video content from unauthorized access.&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;forced-color-adjust: none; font-family: Helvetica; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: left; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; background-color: rgb(27, 29, 30); box-shadow: none !important;&quot;&gt;&lt;font style=&quot;color: light-dark(rgb(255, 255, 255), rgb(22, 22, 22)); font-size: 7px; forced-color-adjust: none; box-shadow: none !important;&quot;&gt;9.&amp;nbsp;&lt;/font&gt;&lt;font style=&quot;font-size: 7px; color: light-dark(rgb(0, 0, 0), rgb(10, 10, 10));&quot;&gt;&lt;strong data-start=&quot;1173&quot; data-end=&quot;1193&quot; style=&quot;background-color: transparent;&quot;&gt;Data Consistency&lt;/strong&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt; — Critical data such as subscription status should have strong consistency, while data such as recommendations and watch history can use eventual consistency where appropriate.&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="200" width="440" x="350" y="295" as="geometry" />
        </mxCell>
